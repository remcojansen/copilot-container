#!/usr/bin/env bash
#
# copilot-container - smoothly run copilot in a container with personal,
# cross-project preferences.
#
# Launches the GitHub Copilot CLI inside a container with the configured
# environment and mounts, per-project persistent state, and SSH-based
# forwarding for SSH/GPG agents and Hunk.
#
# Usage:
#   copilot-container [-m <path> ...] [options] [-- <copilot CLI args...>]
#
# Options:
#   -m, --mount <host_path>[:<container_path>]
#                            Bind-mount a host directory (repeatable).
#                            Defaults to the current directory if omitted.
#                            If no container path is given, it is mounted
#                            at the same absolute path inside the
#                            container as on the host, so paths stay
#                            recognizable. The *first* --mount given is
#                            treated as the primary project: its directory
#                            is the container's working directory, and its
#                            path is used to derive the per-project state
#                            volume name.
#   -i, --image <name>       Container image to run (default: copilot-container)
#   -e, --engine <podman|docker>
#                            Force a specific container engine
#   -g, --gitconfig <path>   Host file to bind-mount read-only as the
#                            container's ~/.gitconfig (default: ~/.gitconfig).
#                            Useful for switching between multiple gitconfig
#                            profiles (e.g. ~/.gitconfig-work) per project.
#   --gpg-agent              Forward host's gpg-agent socket and mount public
#                            keyrings for GPG commit signing.
#   --ssh-agent              Forward host's SSH_AUTH_SOCK (ssh-agent) for SSH
#                            public-key auth and SSH commit signing.
#   --hunk-agent             Enable agent access to host Hunk live sessions by
#                            forwarding Hunk's broker host/runtime state.
#   -h, --help               Show this help and exit
#
# Any arguments after `--` are forwarded verbatim to the `copilot` CLI
# inside the container (e.g. --model, permission flags, etc.).
#
# Environment:
#   GH_TOKEN / GITHUB_TOKEN   Passed into the container if set on the host.
#                             GH_TOKEN falls back to `gh auth token` when
#                             unset and `gh` is available.
#   HUNK_MCP_PORT             Passed into the container with --hunk-agent if set.
#   COPILOT_CONTAINER_ENGINE  Force engine selection (podman|docker).
#   COPILOT_CONTAINER_IMAGE   Default image name/tag to run.

set -euo pipefail

# --- Container engine detection -------------------------------------------
# Podman is preferred over Docker; override with COPILOT_CONTAINER_ENGINE.

detect_engine() {
    if [ -n "${COPILOT_CONTAINER_ENGINE:-}" ]; then
        if command -v "${COPILOT_CONTAINER_ENGINE}" >/dev/null 2>&1; then
            echo "${COPILOT_CONTAINER_ENGINE}"
            return 0
        fi
        echo "error: COPILOT_CONTAINER_ENGINE=${COPILOT_CONTAINER_ENGINE} is set but not found on PATH" >&2
        return 1
    fi

    if command -v podman >/dev/null 2>&1; then
        echo "podman"
        return 0
    fi

    if command -v docker >/dev/null 2>&1; then
        echo "docker"
        return 0
    fi

    echo "error: neither podman nor docker was found on PATH" >&2
    return 1
}

# generate_bridge_credentials: creates an ephemeral keypair + authorized_keys
# for this run's SSH login, in BRIDGE_TMP (caller creates/removes it via the
# EXIT trap).
generate_bridge_credentials() {
    ssh-keygen -q -t ed25519 -N "" -f "${BRIDGE_TMP}/id_ed25519"

    # No pty/shell beyond the one remote command ssh is told to run.
    authorized_key_opts="no-x11-forwarding,no-user-rc"
    AUTHORIZED_KEYS_B64="$(printf '%s %s\n' "${authorized_key_opts}" \
        "$(cat "${BRIDGE_TMP}/id_ed25519.pub")" | base64 | tr -d '\n')"
}

# wait_for_published_port <engine> <container_name>: polls until the
# container's sshd port is published, and prints the host-side port number.
wait_for_published_port() {
    engine="$1"
    container_name="$2"
    port=""
    for _ in $(seq 1 "${COPILOT_CONTAINER_POLL_ATTEMPTS}"); do
        port="$("${engine}" port "${container_name}" 2222/tcp 2>/dev/null \
            | tail -n1 | sed -E 's/.*:([0-9]+)$/\1/')"
        [ -n "${port}" ] && break
        sleep 0.2
    done
    if [ -z "${port}" ]; then
        echo "error: copilot-container: container's sshd port was never published" >&2
        return 1
    fi
    echo "${port}"
}

# wait_for_ssh_ready <ssh_opts...>: retries a lightweight non-interactive
# connection until the container's sshd actually accepts the key and
# on timeout, surfaces the last attempt's stderr.
wait_for_ssh_ready() {
    local last_err=""
    for _ in $(seq 1 "${COPILOT_CONTAINER_POLL_ATTEMPTS}"); do
        if last_err="$(ssh -o BatchMode=yes "$@" copilot@127.0.0.1 true 2>&1)"; then
            return 0
        fi
        sleep 0.2
    done
    echo "error: copilot-container: timed out waiting for container's sshd to become ready" >&2
    if [ -n "${last_err}" ]; then
        echo "last ssh attempt's error was:" >&2
        printf '%s\n' "${last_err}" | sed 's/^/  /' >&2
    fi
    return 1
}

IMAGE="${COPILOT_CONTAINER_IMAGE:-copilot-container}"
GITCONFIG_PATH="${HOME}/.gitconfig"
GPG_AGENT=0
SSH_AGENT=0
HUNK_AGENT=0
MOUNT_ARGS=()
FORWARD_ARGS=()

# How many 0.2s polling attempts (~150 => 30s) to wait for the container's
# port to be published / its sshd to accept a connection.
COPILOT_CONTAINER_POLL_ATTEMPTS="${COPILOT_CONTAINER_POLL_ATTEMPTS:-150}"

usage() {
    sed -n '2,49p' "$0" | sed 's/^# \{0,1\}//'
}

require_option_value() {
    option="$1"
    value="${2:-}"
    if [ -z "${value}" ]; then
        echo "error: ${option} requires a value" >&2
        usage >&2
        exit 2
    fi
}

while [ $# -gt 0 ]; do
    case "$1" in
        -m|--mount)
            require_option_value "$1" "${2:-}"
            MOUNT_ARGS+=("$2")
            shift 2
            ;;
        -i|--image)
            require_option_value "$1" "${2:-}"
            IMAGE="$2"
            shift 2
            ;;
        -e|--engine)
            require_option_value "$1" "${2:-}"
            case "$2" in
                podman|docker) ;;
                *)
                    echo "error: --engine must be podman or docker: $2" >&2
                    exit 2
                    ;;
            esac
            COPILOT_CONTAINER_ENGINE="$2"
            export COPILOT_CONTAINER_ENGINE
            shift 2
            ;;
        -g|--gitconfig)
            require_option_value "$1" "${2:-}"
            GITCONFIG_PATH="$2"
            shift 2
            ;;
        --gpg-agent)
            GPG_AGENT=1
            shift
            ;;
        --ssh-agent)
            SSH_AGENT=1
            shift
            ;;
        --hunk-agent)
            HUNK_AGENT=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            FORWARD_ARGS+=("$@")
            break
            ;;
        *)
            FORWARD_ARGS+=("$1")
            shift
            ;;
    esac
done

if [ "${#MOUNT_ARGS[@]}" -eq 0 ]; then
    MOUNT_ARGS=("${PWD}")
fi

if [ "${GITCONFIG_PATH}" != "${HOME}/.gitconfig" ] && [ ! -f "${GITCONFIG_PATH}" ]; then
    echo "error: --gitconfig file not found: ${GITCONFIG_PATH}" >&2
    exit 1
fi

# --- Validate GPG/SSH agent forwarding requirements ----------------------
# Both --gpg-agent and --ssh-agent forward host sockets over the SSH session.
BRIDGE_DIR="/home/copilot/.copilot-container-bridge"

GPG_FLAGS=()
SSH_FLAGS=()
REMOTE_ENV_VARS=()
gpg_socket=""
if [ "${GPG_AGENT}" -eq 1 ]; then
    gpg_socket="$(gpgconf --list-dirs agent-socket 2>/dev/null || echo "${HOME}/.gnupg/S.gpg-agent")"
    if [ ! -S "${gpg_socket}" ]; then
        echo "error: --gpg-agent requested, but GPG agent socket not found at: ${gpg_socket}" >&2
        echo "hint: ensure gpg-agent is running on the host (e.g. gpgconf --launch gpg-agent)" >&2
        exit 1
    fi
    if [ -f "${HOME}/.gnupg/pubring.kbx" ]; then
        GPG_FLAGS+=(-v "${HOME}/.gnupg/pubring.kbx:${BRIDGE_DIR}/pubring.kbx:ro")
    fi
    if [ -f "${HOME}/.gnupg/pubring.gpg" ]; then
        GPG_FLAGS+=(-v "${HOME}/.gnupg/pubring.gpg:${BRIDGE_DIR}/pubring.gpg:ro")
    fi
    if [ -f "${HOME}/.gnupg/trustdb.gpg" ]; then
        GPG_FLAGS+=(-v "${HOME}/.gnupg/trustdb.gpg:${BRIDGE_DIR}/trustdb.gpg:ro")
    fi
    REMOTE_ENV_VARS+=("GNUPGHOME=${BRIDGE_DIR}")
fi

ssh_agent_sock_host=""
if [ "${SSH_AGENT}" -eq 1 ]; then
    ssh_agent_sock_host="${SSH_AUTH_SOCK:-}"
    if [ -z "${ssh_agent_sock_host}" ] || [ ! -S "${ssh_agent_sock_host}" ]; then
        echo "error: --ssh-agent requested, but SSH_AUTH_SOCK is not set to a valid socket" >&2
        echo "hint: ensure ssh-agent is running on the host and SSH_AUTH_SOCK is exported" >&2
        exit 1
    fi
    if [ -f "${HOME}/.ssh/known_hosts" ]; then
        SSH_FLAGS+=(-v "${HOME}/.ssh/known_hosts:/etc/ssh/ssh_known_hosts:ro")
    fi
    REMOTE_ENV_VARS+=("SSH_AUTH_SOCK=${BRIDGE_DIR}/ssh-agent.sock")
fi

ENGINE="$(detect_engine)"

# --- Hunk live-session forwarding ---------------------------------------
HUNK_FLAGS=()
if [ "${HUNK_AGENT}" -eq 1 ]; then
    hunk_runtime_dir=""
    if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "${XDG_RUNTIME_DIR}/hunk-mcp" ]; then
        hunk_runtime_dir="${XDG_RUNTIME_DIR}/hunk-mcp"
    elif [ -d "${HOME}/.hunk/hunk-mcp" ]; then
        hunk_runtime_dir="${HOME}/.hunk/hunk-mcp"
    else
        echo "error: --hunk-agent requested, but no host Hunk runtime state was found" >&2
        echo "hint: start Hunk on the host first, then retry" >&2
        exit 1
    fi
    HUNK_FLAGS+=(-v "${hunk_runtime_dir}:/home/copilot/.hunk/hunk-mcp:ro")
    hunk_broker_port="${HUNK_MCP_PORT:-47657}"
    case "${hunk_broker_port}" in
        ''|*[!0-9]*)
            echo "error: HUNK_MCP_PORT must be a numeric TCP port" >&2
            exit 1
            ;;
    esac
    if [ "${hunk_broker_port}" -lt 1 ] || [ "${hunk_broker_port}" -gt 65535 ]; then
        echo "error: HUNK_MCP_PORT must be between 1 and 65535" >&2
        exit 1
    fi
    REMOTE_ENV_VARS+=("XDG_RUNTIME_DIR=/home/copilot/.hunk")
    REMOTE_ENV_VARS+=("HUNK_MCP_HOST=127.0.0.1")
    REMOTE_ENV_VARS+=("HUNK_MCP_PORT=${hunk_broker_port}")
fi

# --- Resolve mounts, preserving host paths inside the container ----------
BIND_FLAGS=()
HOST_PATHS=()
CONTAINER_PATHS=()
for m in "${MOUNT_ARGS[@]}"; do
    if [ -z "${m}" ]; then
        echo "error: mount path must not be empty" >&2
        exit 2
    fi
    if [[ "${m}" == *:* ]]; then
        host_path="${m%:*}"
        container_path="${m##*:}"
    else
        host_path="${m}"
        container_path="${host_path}"
    fi
    if [ -z "${host_path}" ]; then
        echo "error: mount source must not be empty: ${m}" >&2
        exit 2
    fi
    if [[ "${container_path}" != /* ]]; then
        echo "error: mount destination must be an absolute path: ${container_path}" >&2
        exit 2
    fi
    if [ ! -d "${host_path}" ]; then
        echo "error: mount source directory not found: ${host_path}" >&2
        exit 2
    fi
    host_path="$(cd -- "${host_path}" && pwd -P)"
    BIND_FLAGS+=(-v "${host_path}:${container_path}")
    HOST_PATHS+=("${host_path}")
    CONTAINER_PATHS+=("${container_path}")
done

PRIMARY_HOST_PATH="${HOST_PATHS[0]}"
PRIMARY_CONTAINER_PATH="${CONTAINER_PATHS[0]}"

# --- Per-project state volume ------------------------------------------
# Derive a stable, human-legible volume name from the primary project's
# path: its basename plus a short hash of the full path (to disambiguate
# same-named projects in different locations).
project_slug="$(basename "${PRIMARY_HOST_PATH}" | tr -c 'a-zA-Z0-9_.-' '_')"
path_hash="$(printf '%s' "${PRIMARY_HOST_PATH}" | shasum -a 256 2>/dev/null | cut -c1-10 || \
             printf '%s' "${PRIMARY_HOST_PATH}" | sha256sum | cut -c1-10)"
VOLUME_NAME="copilot-container_${project_slug}_${path_hash}"

"${ENGINE}" volume inspect "${VOLUME_NAME}" >/dev/null 2>&1 || \
    "${ENGINE}" volume create "${VOLUME_NAME}" >/dev/null

# --- Host UID/GID for aligning the container's runtime user --------------
HOST_UID="$(id -u)"
HOST_GID="$(id -g)"

# --- Host git configuration --------------------------------------------
# Mounted read-only: the container can read your identity/aliases, but
# changes made inside the container do not write back to the host file.
GIT_FLAGS=()
if [ -f "${GITCONFIG_PATH}" ]; then
    GIT_FLAGS+=(-v "${GITCONFIG_PATH}:/home/copilot/.gitconfig:ro")
fi

# --- Host Copilot CLI config/instructions --------------------------------
# Mounted read-only from your real ~/.copilot, same as .gitconfig: no
# defaults are baked into the image, so these reflect whatever you already
# have configured on the host. Everything else under ~/.copilot (session
# state, permissions-config.json, etc.) stays in the per-project named
# volume, unaffected by these mounts.
#
# config.json is mounted to a staging path rather than its final location:
# the entrypoint seed-copies it into the writable per-project volume on
# first run, so directory-trust approvals and other config updates made
# from inside the container persist across sessions (they'd otherwise fail
# with "permission denied" against a read-only bind mount).
COPILOT_FLAGS=()
if [ -f "${HOME}/.copilot/config.json" ]; then
    COPILOT_FLAGS+=(-v "${HOME}/.copilot/config.json:/home/copilot/.copilot-config-seed.json:ro")
fi
if [ -f "${HOME}/.copilot/copilot-instructions.md" ]; then
    COPILOT_FLAGS+=(-v "${HOME}/.copilot/copilot-instructions.md:/home/copilot/.copilot/copilot-instructions.md:ro")
fi

# --- Assemble run flags ------------------------------------------------
CONTAINER_NAME="copilot-container-$$-${RANDOM}"
BRIDGE_TMP="$(mktemp -d)"
# Single early trap: covers both normal exit and any failure between here
# and the final `ssh -t` below. Since this launcher no longer ends via
# `exec`, this reliably runs after the interactive session finishes too.
trap 'rm -rf "${BRIDGE_TMP}"; "${ENGINE}" rm -f "${CONTAINER_NAME}" >/dev/null 2>&1 || true' EXIT

generate_bridge_credentials

RUN_FLAGS=(
    -d --rm
    --name "${CONTAINER_NAME}"
    -p "127.0.0.1::2222"
    "${BIND_FLAGS[@]}"
    -v "${VOLUME_NAME}:/home/copilot"
    "${GIT_FLAGS[@]}"
    "${COPILOT_FLAGS[@]}"
    "${GPG_FLAGS[@]}"
    "${SSH_FLAGS[@]}"
    "${HUNK_FLAGS[@]}"
    -e "HOST_UID=${HOST_UID}"
    -e "HOST_GID=${HOST_GID}"
    -e "AUTHORIZED_KEYS_B64=${AUTHORIZED_KEYS_B64}"
)

# Ensure current user's UID and GID are preserved in the container when
# running rootless Podman (default on most Linux distributions).
if [ "${ENGINE}" = "podman" ]; then
    RUN_FLAGS+=(--userns=keep-id --user root)
fi

# GH token passthrough (never persisted, only forwarded if present on host).
# Falls back to `gh auth token` when GH_TOKEN isn't already set.
# Passed to the remote `copilot` invocation itself (see below), not as
# container -e flags: sshd doesn't inherit its own daemon environment into
# spawned login sessions.
if [ -z "${GH_TOKEN:-}" ] && command -v gh >/dev/null 2>&1; then
    GH_TOKEN="$(gh auth token 2>/dev/null || true)"
fi
if [ -n "${GH_TOKEN:-}" ]; then
    REMOTE_ENV_VARS+=("GH_TOKEN=${GH_TOKEN}")
fi
if [ -n "${GITHUB_TOKEN:-}" ]; then
    REMOTE_ENV_VARS+=("GITHUB_TOKEN=${GITHUB_TOKEN}")
fi

# --- Start the container detached, then connect in over SSH -------------
"${ENGINE}" run "${RUN_FLAGS[@]}" "${IMAGE}" >/dev/null

bridge_port="$(wait_for_published_port "${ENGINE}" "${CONTAINER_NAME}")"

ssh_common_opts=(
    -p "${bridge_port}"
    -i "${BRIDGE_TMP}/id_ed25519"
    -o IdentitiesOnly=yes
    -o ConnectTimeout=5
    -o StrictHostKeyChecking=no
    -o UserKnownHostsFile=/dev/null
    -o GlobalKnownHostsFile=/dev/null
    -o LogLevel=ERROR
)

wait_for_ssh_ready "${ssh_common_opts[@]}"

ssh_forward_flags=()
if [ "${GPG_AGENT}" -eq 1 ]; then
    ssh_forward_flags+=(-R "${BRIDGE_DIR}/S.gpg-agent:${gpg_socket}")
fi
if [ "${SSH_AGENT}" -eq 1 ]; then
    ssh_forward_flags+=(-R "${BRIDGE_DIR}/ssh-agent.sock:${ssh_agent_sock_host}")
fi
if [ "${HUNK_AGENT}" -eq 1 ]; then
    ssh_forward_flags+=(
        -o ExitOnForwardFailure=yes
        -R "127.0.0.1:${hunk_broker_port}:127.0.0.1:${hunk_broker_port}"
    )
fi

# Build the remote command as a single already-quoted string: `ssh`
# naively space-joins multiple trailing args without re-quoting, which
# breaks on values containing spaces/metacharacters (e.g. GH_TOKEN), and
# sshd's own SetEnv has its own parsing gotchas (e.g. with `#`). %q-quoting
# every piece here and passing it as one argv element sidesteps both.
remote_cmd="cd $(printf '%q' "${PRIMARY_CONTAINER_PATH}")"
# Prepend asdf's shims dir so per-project pinned tool versions (see the
# first-run setup script) take priority; asdf only ever creates a shim for
# a plugin the project has actually opted into, so this has no effect
# until then.
remote_cmd+=" && export PATH=/home/copilot/.asdf/shims:\${PATH}"
for kv in "${REMOTE_ENV_VARS[@]+"${REMOTE_ENV_VARS[@]}"}"; do
    name="${kv%%=*}"
    value="${kv#*=}"
    remote_cmd+=" && export ${name}=$(printf '%q' "${value}")"
done
remote_cmd+=" && exec copilot"
for arg in "${FORWARD_ARGS[@]+"${FORWARD_ARGS[@]}"}"; do
    remote_cmd+=" $(printf '%q' "${arg}")"
done

ssh -t "${ssh_common_opts[@]}" "${ssh_forward_flags[@]}" \
    copilot@127.0.0.1 -- "${remote_cmd}"
